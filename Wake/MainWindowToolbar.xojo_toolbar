#tag DesktopToolbar
Begin DesktopToolbar MainWindowToolbar
Inherits DesktopToolbar
	Style = 0
	Begin DesktopToolbarButton KindItem
		Caption = "All events"
		Tooltip = ""
		ButtonStyle = 3
		Symbol = ""
	End
	Begin DesktopToolbarButton DateItem
		Caption = "Any time"
		Tooltip = ""
		ButtonStyle = 3
		Symbol = ""
	End
End
#tag EndDesktopToolbar
