#tag DesktopToolbar
Begin DesktopToolbar UsageToolbar
Inherits DesktopToolbar
	Style = 0
	Begin DesktopToolbarButton GroupItem
		Caption = "By day"
		Tooltip = ""
		ButtonStyle = 3
		Symbol = ""
	End
	Begin DesktopToolbarButton PeriodItem
		Caption = "Last 30 days"
		Tooltip = ""
		ButtonStyle = 3
		Symbol = ""
	End
End
#tag EndDesktopToolbar
