#tag EndDesktopWindow

#tag WindowCode
	#tag Event
		Sub Activated()
		  // Picks up an appearance change made while the window was open.
		  ColorLink
		End Sub
	#tag EndEvent

	#tag Event
		Function KeyDown(key As String) As Boolean
		  Return CloseOnEscape(key)
		End Function
	#tag EndEvent

	#tag Event
		Sub Opening()
		  // Everything shown comes from the project or the app's resources, so nothing here drifts.
		  Var version As String = "Version " + App.Version
		  If App.NonReleaseVersion > 0 Then version = version + " (build " + App.NonReleaseVersion.ToString + ")"
		  VersionLabel.Text = version
		  
		  AcknowledgementsLabel.Text = "Built with Xojo." + &u0A + _
		  "SQLite and its FTS5 full-text search (public domain)." + &u0A + _
		  "Tested with XojoUnit, © 2014-2021 Xojo, Inc. (MIT License)."
		  
		  ColorLink
		  mIcon = LoadIcon
		  LicenseArea.Text = LicenseText
		End Sub
	#tag EndEvent


	#tag MenuHandler
		Function FileCloseWindow() As Boolean Handles FileCloseWindow.Action
		  Self.Close
		  Return True
		End Function
	#tag EndMenuHandler

	#tag MenuHandler
		Function HelpAbout() As Boolean Handles HelpAbout.Action
		  Self.Show
		  Return True
		End Function
	#tag EndMenuHandler

	#tag MenuHandler
		Function ViewWatchForChanges() As Boolean Handles ViewWatchForChanges.Action
		  App.ToggleWatching
		  Return True
		End Function
	#tag EndMenuHandler

	#tag MenuHandler
		Function WindowPrices() As Boolean Handles WindowPrices.Action
		  PricesWindow.Show
		  Return True
		End Function
	#tag EndMenuHandler

	#tag MenuHandler
		Function WindowUsage() As Boolean Handles WindowUsage.Action
		  UsageWindow.Show
		  Return True
		End Function
	#tag EndMenuHandler


	#tag Method, Flags = &h21
		Private Function CloseOnEscape(key As String) As Boolean
		  If key.Asc <> 27 Then Return False
		  Self.Close
		  Return True
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub ColorLink()
		  // macOS's link blue. Xojo has no link colour, and the highlight colour is too pale for text.
		  If Color.IsDarkMode Then
		    LinkLabel.TextColor = Color.RGB(65, 156, 255)
		  Else
		    LinkLabel.TextColor = Color.RGB(0, 104, 218)
		  End If
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function LicenseText() As String
		  // Wake's license, then XojoUnit's, whose MIT terms ask for the notice in every copy: the test
		  // classes are compiled into the app. A Copy Files build step puts both in the resources.
		  Var wake As String = ReadResource("LICENSE")
		  Var xojoUnit As String = ReadResource("LICENSE.txt")
		  If wake = "" Or xojoUnit = "" Then Return "The license texts are missing from this copy of Wake."
		  
		  Return "Wake" + &u0A + &u0A + wake.Trim + &u0A + &u0A + &u0A + _
		  "XojoUnit" + &u0A + &u0A + xojoUnit.Trim + &u0A
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function LoadIcon() As Picture
		  Try
		    Var f As FolderItem = SpecialFolder.Resource(kIconResource)
		    If f = Nil Or Not f.Exists Then Return Nil
		    Return Picture.Open(f)
		  Catch e As IOException
		    Return Nil
		  End Try
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function ReadResource(name As String) As String
		  Try
		    Var f As FolderItem = SpecialFolder.Resource(name)
		    If f = Nil Or Not f.Exists Then Return ""
		    Var stream As TextInputStream = TextInputStream.Open(f)
		    Var text As String = stream.ReadAll(Encodings.UTF8)
		    stream.Close
		    Return text.ReplaceLineEndings(&u0A)
		  Catch e As IOException
		    Return ""
		  End Try
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub ShowLicenses(show As Boolean)
		  // The window grows to show the texts under the button and shrinks back to hide them.
		  LicenseArea.Visible = show
		  If show Then
		    Self.Height = LicenseArea.Top + LicenseArea.Height + 20
		    LicenseButton.Caption = "Hide Licenses"
		  Else
		    Self.Height = LicenseArea.Top
		    LicenseButton.Caption = "Show Licenses"
		  End If
		End Sub
	#tag EndMethod


	#tag Property, Flags = &h21
		Private mIcon As Picture
	#tag EndProperty


	#tag Constant, Name = kGitHubURL, Type = String, Dynamic = False, Default = \"https://github.com/piradoiv/wake", Scope = Private
	#tag EndConstant

	#tag Constant, Name = kIconResource, Type = String, Dynamic = False, Default = \"wake-256.png", Scope = Private
	#tag EndConstant


#tag EndWindowCode

#tag Events IconCanvas
	#tag Event
		Sub Paint(g As Graphics, areas() As Rect)
		  #Pragma Unused areas
		  If mIcon = Nil Then Return
		  g.DrawPicture(mIcon, 0, 0, g.Width, g.Height, 0, 0, mIcon.Width, mIcon.Height)
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events LinkLabel
	#tag Event
		Function MouseDown(x As Integer, y As Integer) As Boolean
		  #Pragma Unused x
		  #Pragma Unused y
		  Return True
		End Function
	#tag EndEvent
	#tag Event
		Sub MouseEnter()
		  Me.MouseCursor = System.Cursors.FingerPointer
		End Sub
	#tag EndEvent
	#tag Event
		Sub MouseExit()
		  Me.MouseCursor = Nil
		End Sub
	#tag EndEvent
	#tag Event
		Sub MouseUp(x As Integer, y As Integer)
		  // Hands the address to the default browser. Wake itself opens no connection.
		  If x >= 0 And y >= 0 And x < Me.Width And y < Me.Height Then System.GotoURL(kGitHubURL)
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events LicenseButton
	#tag Event
		Sub Pressed()
		  ShowLicenses(Not LicenseArea.Visible)
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events LicenseArea
	#tag Event
		Function KeyDown(key As String) As Boolean
		  Return CloseOnEscape(key)
		End Function
	#tag EndEvent
#tag EndEvents
